def check_and_handle_verification(alias, tdata, interactive=True):
    """
    Checks quota/eligibility immediately after an account switch or refresh.
    If Google requires verification, prints the link with step-by-step guidance
    and provides an interactive prompt to auto-refresh token upon verification.
    """
    token = tdata.get("token", {}).get("access_token")
    if not token:
        return False

    email = None
    accounts = load_accounts().get("profiles", {})
    if alias in accounts:
        email = accounts[alias].get("email")

    res = check_quota_and_verification(token)
    if res["status"] == "ok":
        groups = res.get("groups", [])
        quota_parts = []
        for g in groups:
            dname = g.get("displayName", "")
            short_name = "Gemini" if "Gemini" in dname else ("Claude/GPT" if "Claude" in dname else dname)
            buckets = g.get("buckets", [])
            b_5h = next((b for b in buckets if b.get("window") == "5h"), None)
            b_wk = next((b for b in buckets if b.get("window") == "weekly"), None)
            if b_5h:
                pct = int(b_5h.get("remainingFraction", 0) * 100)
                quota_parts.append(f"{short_name} (5h: {pct}%)")
            elif b_wk:
                pct = int(b_wk.get("remainingFraction", 0) * 100)
                quota_parts.append(f"{short_name} (wk: {pct}%)")

        if quota_parts:
            print(dim("   Live Quota: ") + cyan(" | ".join(quota_parts)))
        return True

    elif res["status"] == "validation_required":
        print()
        print(bold(yellow("===============================================================")))
        print(bold(yellow("   ⚠️  ACTION REQUIRED: GOOGLE ACCOUNT VERIFICATION NEEDED!   ")))
        print(bold(yellow("===============================================================")))
        print(red("Google requires identity verification for this account before granting API quota."))
        print(bold(cyan("\n🔗 Direct Verification Link:")))
        print(style(res["url"], 4, 36))
        print()
        print(bold(yellow("👉 STEP 1:")) + f" Copy the link above and open in an {bold('INCOGNITO / PRIVATE tab')}.")
        if email:
            print(f"         Sign in specifically as: {bold(cyan(email))}")
            print(dim("         (Do NOT open in regular Chrome if another Google account is default!)"))
        print(bold(yellow("👉 STEP 2:")) + " Complete the verification prompt in your browser.")
        print()

        if interactive and sys.stdin.isatty():
            try:
                input(bold(green("👉 STEP 3: Press [Enter] here once verified in browser to auto-refresh... ")))
                print(cyan("\nRefreshing token and validating with Google..."))
                new_tdata = refresh_oauth_token(tdata)
                token_file = os.path.join(PROFILES_DIR, alias, "antigravity-oauth-token")
                with open(token_file, "w") as f:
                    json.dump(new_tdata, f, indent=2)
                safe_chmod_600(token_file)

                if alias == get_active_alias():
                    with open(CLI_TOKEN_PATH, "w") as f:
                        json.dump(new_tdata, f, indent=2)
                    safe_chmod_600(CLI_TOKEN_PATH)

                recheck = check_quota_and_verification(new_tdata.get("token", {}).get("access_token"))
                if recheck["status"] == "ok":
                    print(bold(green("\n✔ Account successfully verified and refreshed!")))
                    print(green(f"✔ Ready to code: {bold('agy -c')}\n"))
                    return True
                else:
                    print(yellow("\n⚠️ Verification is still pending on Google. When finished in browser, run:"))
                    print(bold(cyan("   agy-switch refresh\n")))
                    return False
            except (KeyboardInterrupt, EOFError):
                print(yellow("\n\nSkipped. Run ") + bold(cyan("agy-switch refresh")) + yellow(" once verified.\n"))
                return False
        else:
            print(bold(yellow("👉 STEP 3:")) + " Run " + bold(cyan("agy-switch refresh")) + " in your terminal.")
            print()
            return False

    return False

def show_quota(target_alias=None):
    """Displays real-time Google quota (Gemini, Claude, GPT) and detects if verification is needed."""
    init_vault()
    sync_active_token_to_vault()
    accounts = load_accounts().get("profiles", {})
    if not accounts:
        print(red("No accounts found in vault. Run 'agy-switch add' to add one."))
        return False

    if not target_alias:
        target_alias = get_active_alias() or list(accounts.keys())[0]

    if target_alias not in accounts:
        matched = None
        for a, m in accounts.items():
            if m.get("email") == target_alias:
                matched = a
                break
        if not matched and target_alias.isdigit():
            idx = int(target_alias)
            keys = list(accounts.keys())
            if 1 <= idx <= len(keys):
                matched = keys[idx - 1]
        if matched:
            target_alias = matched
        else:
            print(red(f"Account '{target_alias}' not found in vault."))
            return False

    meta = accounts[target_alias]
    token_file = os.path.join(PROFILES_DIR, target_alias, "antigravity-oauth-token")
    if not os.path.exists(token_file):
        print(red(f"Token file missing for '{target_alias}'."))
        return False

    with open(token_file, "r") as f:
        tdata = json.load(f)

    tdata, refreshed = ensure_valid_token(tdata)
    if refreshed:
        with open(token_file, "w") as f:
            json.dump(tdata, f, indent=2)
        safe_chmod_600(token_file)
        if target_alias == get_active_alias():
            with open(CLI_TOKEN_PATH, "w") as f:
                json.dump(tdata, f, indent=2)
            safe_chmod_600(CLI_TOKEN_PATH)

    access_token = tdata.get("token", {}).get("access_token")
    if not access_token:
        print(red("No access token found in profile."))
        return False

    print()
    print(bold(cyan("===============================================================")))
    print(bold(cyan("           ANTIGRAVITY LIVE QUOTA & ELIGIBILITY STATUS         ")))
    print(bold(cyan("===============================================================")))
    print(f"  Account: {bold(target_alias)} ({cyan(meta.get('email'))})")

    res = check_quota_and_verification(access_token)
    if res["status"] == "ok":
        print(f"  Status:  {bold(green('✔ Verified & Eligible'))}\n")
        groups = res.get("groups", [])
        for g in groups:
            name = g.get("displayName", "Models")
            print(f"● {bold(name)}:")
            for b in g.get("buckets", []):
                dname = b.get("displayName", b.get("window", ""))
                rem = b.get("remainingFraction", 0)
                pct = int(rem * 100)
                if pct > 40:
                    pct_str = green(f"{pct}%")
                elif pct > 10:
                    pct_str = yellow(f"{pct}%")
                else:
                    pct_str = red(f"{pct}%")
                print(f"  └─ {dname.ljust(28)}: {pct_str} remaining")
                desc_line = b.get("description", "")
                if desc_line:
                    print(f"     {dim(desc_line)}")
            print()
        print(dim("---------------------------------------------------------------"))
        print(dim("ℹ Tip: When limits are exhausted, switch accounts instantly with: ") + bold(cyan("agy switch")))
        print()
        return True

    elif res["status"] == "validation_required":
        print(f"  Status:  {bold(red('⚠️ Google Verification Required!'))}\n")
        print(red("Google requires security verification for this account before granting API quota."))
        print(bold(cyan("\n🔗 Direct Verification Link:")))
        print(style(res["url"], 4, 36))
        print()
        print(bold(yellow("👉 STEP 1:")) + f" Copy the link and open it in an {bold('INCOGNITO / PRIVATE tab')}.")
        print(f"         Sign in specifically as: {bold(cyan(meta.get('email')))}")
        print(dim("         (Avoid opening in regular browser if another account is default!)"))
        print(bold(yellow("👉 STEP 2:")) + " Complete the verification on screen.")
        print()

        if sys.stdin.isatty():
            try:
                input(bold(green("👉 STEP 3: Press [Enter] here once verified in browser to auto-refresh... ")))
                print(cyan("\nRefreshing token and validating with Google..."))
                new_tdata = refresh_oauth_token(tdata)
                with open(token_file, "w") as f:
                    json.dump(new_tdata, f, indent=2)
                safe_chmod_600(token_file)

                if target_alias == get_active_alias():
                    with open(CLI_TOKEN_PATH, "w") as f:
                        json.dump(new_tdata, f, indent=2)
                    safe_chmod_600(CLI_TOKEN_PATH)

                recheck = check_quota_and_verification(new_tdata.get("token", {}).get("access_token"))
                if recheck["status"] == "ok":
                    print(bold(green("\n✔ Account successfully verified and refreshed!")))
                    print(green(f"✔ Ready to code: {bold('agy -c')}\n"))
                    return True
                else:
                    print(yellow("\n⚠️ Verification is still pending. Once finished in browser, run:"))
                    print(bold(cyan("   agy-switch refresh\n")))
                    return False
            except (KeyboardInterrupt, EOFError):
                print(yellow("\n\nSkipped. Run ") + bold(cyan("agy-switch refresh")) + yellow(" once verified.\n"))
                return False
        else:
            print(bold(yellow("👉 STEP 3:")) + " Run " + bold(cyan("agy-switch refresh")) + " after verifying.")
            print()
            return False
    else:
        print(f"  Status:  {yellow('Could not retrieve quota (' + res.get('message', 'unknown error') + ')')}")
        print()
        return False

def force_refresh(alias=None):
    init_vault()
    sync_active_token_to_vault()
    target = alias or get_active_alias()
    accounts = load_accounts().get("profiles", {})
    if not target or target not in accounts:
        print(red(f"Account '{target}' not found."))
        return False

    token_file = os.path.join(PROFILES_DIR, target, "antigravity-oauth-token")
    if not os.path.exists(token_file):
        print(red(f"Token file for '{target}' missing."))
        return False

    try:
        with open(token_file, "r") as f:
            tdata = json.load(f)
        refreshed = refresh_oauth_token(tdata)
        with open(token_file, "w") as f:
            json.dump(refreshed, f, indent=2)
        safe_chmod_600(token_file)

        if target == get_active_alias():
            with open(CLI_TOKEN_PATH, "w") as f:
                json.dump(refreshed, f, indent=2)
            safe_chmod_600(CLI_TOKEN_PATH)

        print(green(f"✔ Token for '{target}' successfully refreshed!"))
        print(f"  New Expiry: {format_expiry(refreshed.get('token', {}).get('expiry'))}")
        check_and_handle_verification(target, refreshed, interactive=True)
        return True
    except Exception as e:
        print(red(f"Refresh failed: {e}"))
        return False

def interactive_menu():
    while True:
        keys = list_accounts()
        print(bold("Actions:"))
        print(f"  [{bold('1-' + str(len(keys)) if keys else 'None')}] Switch to account")
        print(f"  [{bold('v')}] View live quota & verification status")
        print(f"  [{bold('a')}] Add new account (Login via Google OAuth)")
        print(f"  [{bold('r')}] Force refresh token")
        print(f"  [{bold('d')}] Delete an account")
        print(f"  [{bold('i')}] Import token file")
        print(f"  [{bold('w')}] Who am I (active details)")
        print(f"  [{bold('q')}] Quit")
        print()

        try:
            choice = input(bold("Select an action or account number: ")).strip().lower()
        except (KeyboardInterrupt, EOFError):
            print("\nGoodbye!")
            break

        if choice in ("q", "exit", "quit", ""):
            print("Goodbye!")
            break
        elif choice.isdigit():
            idx = int(choice)
            if 1 <= idx <= len(keys):
                switch_account(keys[idx - 1])
                try: input("\nPress Enter to continue...")
                except Exception: pass
            else:
                print(red("Invalid account number."))
                time.sleep(1)
        elif choice in ("v", "quota", "usage", "verify"):
            show_quota()
            try: input("\nPress Enter to continue...")
            except Exception: pass
        elif choice == "a":
            add_account()
            try: input("\nPress Enter to continue...")
            except Exception: pass
        elif choice == "r":
            force_refresh()
            try: input("\nPress Enter to continue...")
            except Exception: pass
        elif choice == "d":
            target = input("Enter alias or number of account to delete: ").strip()
            if target.isdigit():
                idx = int(target)
                if 1 <= idx <= len(keys):
                    target = keys[idx - 1]
            if target:
                remove_account(target)
            try: input("\nPress Enter to continue...")
            except Exception: pass
        elif choice == "i":
            path = input("Enter path to token JSON file: ").strip()
            al = input("Enter alias for this account (optional): ").strip() or None
            import_token(path, al)
            try: input("\nPress Enter to continue...")
            except Exception: pass
        elif choice == "w":
            show_whoami()
            try: input("\nPress Enter to continue...")
            except Exception: pass
        else:
            print(red("Unknown option."))
            time.sleep(1)

def main():
    parser = argparse.ArgumentParser(
        description="Universal Multi-Account Switcher for Antigravity CLI (agy)",
        formatter_class=argparse.RawDescriptionHelpFormatter
    )
    subparsers = parser.add_subparsers(dest="command", help="Available subcommands")

    subparsers.add_parser("list", aliases=["ls"], help="List all saved accounts")

    sw_parser = subparsers.add_parser("switch", aliases=["use", "s"], help="Switch to an account")
    sw_parser.add_argument("account", help="Account alias, index, or email")

    ck_parser = subparsers.add_parser("check", aliases=["quota", "usage", "verify"], help="Check live quota and account verification status")
    ck_parser.add_argument("alias", nargs="?", default=None, help="Account alias (defaults to active)")

    add_parser = subparsers.add_parser("add", aliases=["login", "new"], help="Add a new Google account")
    add_parser.add_argument("alias", nargs="?", default=None, help="Optional alias for the account")

    subparsers.add_parser("whoami", aliases=["current", "status"], help="Show active account details")

    rf_parser = subparsers.add_parser("refresh", help="Force refresh token for an account")
    rf_parser.add_argument("alias", nargs="?", default=None, help="Account alias (defaults to active)")

    rm_parser = subparsers.add_parser("remove", aliases=["rm", "delete"], help="Delete an account profile")
    rm_parser.add_argument("alias", help="Account alias to remove")

    rn_parser = subparsers.add_parser("rename", help="Rename an account alias")
    rn_parser.add_argument("old", help="Old alias")
    rn_parser.add_argument("new", help="New alias")

    im_parser = subparsers.add_parser("import", help="Import token JSON file")
    im_parser.add_argument("file", help="Path to antigravity-oauth-token JSON")
    im_parser.add_argument("alias", nargs="?", default=None, help="Optional alias")

    ex_parser = subparsers.add_parser("export", help="Export account token to a file")
    ex_parser.add_argument("alias", help="Account alias")
    ex_parser.add_argument("file", help="Destination file path")

    subparsers.add_parser("sync", help="Sync currently active token to vault")

    args = parser.parse_args()

    if not args.command:
        interactive_menu()
    elif args.command in ("list", "ls"):
        list_accounts()
    elif args.command in ("switch", "use", "s"):
        switch_account(args.account)
    elif args.command in ("check", "quota", "usage", "verify"):
        show_quota(args.alias)
    elif args.command in ("add", "login", "new"):
        add_account(args.alias)
    elif args.command in ("whoami", "current", "status"):
        show_whoami()
    elif args.command == "refresh":
        force_refresh(args.alias)
    elif args.command in ("remove", "rm", "delete"):
        remove_account(args.alias)
    elif args.command == "rename":
        rename_account(args.old, args.new)
    elif args.command == "import":
        import_token(args.file, args.alias)
    elif args.command == "export":
        export_token(args.alias, args.file)
    elif args.command == "sync":
        init_vault()
        sync_active_token_to_vault()
        print(green("✔ Active token successfully synchronized to vault."))

if __name__ == "__main__":
    main()
