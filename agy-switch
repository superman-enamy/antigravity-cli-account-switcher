# --- Token & Expiry Utilities ---
def parse_expiry(expiry_str):
    if not expiry_str:
        return None
    try:
        clean = expiry_str.rstrip("Z")
        if "." in clean:
            parts = clean.split(".")
            clean = parts[0] + "." + parts[1][:6]
        return datetime.fromisoformat(clean).replace(tzinfo=timezone.utc)
    except Exception:
        return None

def format_expiry(expiry_str):
    exp = parse_expiry(expiry_str)
    if not exp:
        return dim("Unknown")
    now = datetime.now(timezone.utc)
    diff = (exp - now).total_seconds()
    if diff <= 0:
        return red("Expired (Auto-refresh on switch)")
    elif diff < 300:
        return yellow(f"Expiring in {int(diff)}s")
    elif diff < 3600:
        return cyan(f"Valid ({int(diff / 60)}m remaining)")
    else:
        hours = diff / 3600
        return green(f"Valid ({hours:.1f}h remaining)")

def fetch_user_info(access_token):
    """Fetches user email and name using Google OAuth userinfo endpoint."""
    req = urllib.request.Request(
        "https://www.googleapis.com/oauth2/v3/userinfo",
        headers={"Authorization": f"Bearer {access_token}"}
    )
    try:
        with urllib.request.urlopen(req, timeout=10) as resp:
            return json.loads(resp.read().decode("utf-8"))
    except Exception as e:
        return {"error": str(e)}

def refresh_oauth_token(token_data):
    """Refreshes the OAuth access token via Google endpoint using refresh_token."""
    tok = token_data.get("token", {})
    refresh_tok = tok.get("refresh_token")
    if not refresh_tok:
        raise ValueError("No refresh_token found in token data")

    body = urllib.parse.urlencode({
        "client_id": CLIENT_ID,
        "client_secret": CLIENT_SECRET,
        "grant_type": "refresh_token",
        "refresh_token": refresh_tok
    }).encode("utf-8")

    req = urllib.request.Request(
        "https://oauth2.googleapis.com/token",
        data=body,
        headers={"Content-Type": "application/x-www-form-urlencoded"}
    )
    with urllib.request.urlopen(req, timeout=15) as resp:
        res = json.loads(resp.read().decode("utf-8"))

    token_data["token"]["access_token"] = res["access_token"]
    token_data["token"]["token_type"] = res.get("token_type", "Bearer")
    if "refresh_token" in res:
        token_data["token"]["refresh_token"] = res["refresh_token"]

    expires_in = res.get("expires_in", 3600)
    new_exp = datetime.now(timezone.utc) + timedelta(seconds=expires_in)
    token_data["token"]["expiry"] = (
        new_exp.strftime("%Y-%m-%dT%H:%M:%S.") + f"{new_exp.microsecond:06d}000Z"
    )
    return token_data

def ensure_valid_token(token_data):
    """Refreshes token if it is expired or expiring within 5 minutes."""
    exp = parse_expiry(token_data.get("token", {}).get("expiry"))
    now = datetime.now(timezone.utc)
    if exp is None or (exp - now).total_seconds() < 300:
        try:
            return refresh_oauth_token(token_data), True
        except Exception:
            return token_data, False
    return token_data, False

def check_quota_and_verification(access_token):
    """Queries Google Antigravity Code Assist retrieveUserQuotaSummary endpoint.
    Returns:
      {"status": "ok", "groups": [...]}
      {"status": "validation_required", "url": "...", "message": "..."}
      {"status": "error", "code": int, "message": str}
    """
    endpoints = [
        "https://daily-cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary",
        "https://cloudcode-pa.googleapis.com/v1internal:retrieveUserQuotaSummary"
    ]
    for url in endpoints:
        req = urllib.request.Request(url, data=b"{}", headers={
            "Authorization": f"Bearer {access_token}",
            "Content-Type": "application/json",
            "User-Agent": "antigravity"
        })
        try:
            with urllib.request.urlopen(req, timeout=6) as resp:
                data = json.loads(resp.read().decode())
                return {"status": "ok", "groups": data.get("groups", [])}
        except urllib.error.HTTPError as e:
            err_body = e.read().decode()
            try:
                err_json = json.loads(err_body)
                for detail in err_json.get("error", {}).get("details", []):
                    meta = detail.get("metadata", {})
                    if meta.get("validation_url"):
                        return {
                            "status": "validation_required",
                            "url": meta.get("validation_url"),
                            "message": meta.get("validation_error_message", "Verify your account to continue.")
                        }
            except Exception:
                pass
            return {"status": "error", "code": e.code, "message": f"HTTP {e.code}"}
        except Exception:
            continue
    return {"status": "error", "message": "Could not connect to Google Code Assist backend"}

# --- Vault Storage ---
def init_vault():
    """Initializes the vault and registers active account if present."""
    os.makedirs(PROFILES_DIR, exist_ok=True)

    if not os.path.exists(ACCOUNTS_JSON):
        with open(ACCOUNTS_JSON, "w") as f:
            json.dump({"profiles": {}}, f, indent=2)

    if not os.path.exists(ACTIVE_JSON):
        with open(ACTIVE_JSON, "w") as f:
            json.dump({"active_alias": ""}, f, indent=2)

    # If vault has no profiles but CLI has a token, auto-register as 'main'
    accounts = load_accounts()
    if not accounts.get("profiles") and os.path.exists(CLI_TOKEN_PATH):
        try:
            with open(CLI_TOKEN_PATH, "r") as f:
                tdata = json.load(f)
            tok, _ = ensure_valid_token(tdata)
            info = fetch_user_info(tok.get("token", {}).get("access_token"))
            email = info.get("email", "primary@google.com")
            name = info.get("name", "Primary Account")
            alias = "main"

            profile_dir = os.path.join(PROFILES_DIR, alias)
            os.makedirs(profile_dir, exist_ok=True)
            profile_token = os.path.join(profile_dir, "antigravity-oauth-token")
            with open(profile_token, "w") as f:
                json.dump(tok, f, indent=2)
            safe_chmod_600(profile_token)

            accounts["profiles"][alias] = {
                "alias": alias,
                "email": email,
                "name": name,
                "added_at": datetime.now(timezone.utc).isoformat(),
                "last_used": datetime.now(timezone.utc).isoformat()
            }
            save_accounts(accounts)
            set_active_alias(alias)
        except Exception:
            pass

def load_accounts():
    try:
        with open(ACCOUNTS_JSON, "r") as f:
            return json.load(f)
    except Exception:
        return {"profiles": {}}

def save_accounts(data):
    with open(ACCOUNTS_JSON, "w") as f:
        json.dump(data, f, indent=2)

def get_active_alias():
    try:
        with open(ACTIVE_JSON, "r") as f:
            return json.load(f).get("active_alias", "")
    except Exception:
        return ""

def set_active_alias(alias):
    with open(ACTIVE_JSON, "w") as f:
        json.dump({
            "active_alias": alias,
            "switched_at": datetime.now(timezone.utc).isoformat()
        }, f, indent=2)

def sync_active_token_to_vault():
    """Syncs the latest refreshed token from agy CLI directory back to the active vault profile."""
    active_alias = get_active_alias()
    if not active_alias or not os.path.exists(CLI_TOKEN_PATH):
        return
    profile_dir = os.path.join(PROFILES_DIR, active_alias)
    if os.path.exists(profile_dir):
        profile_token = os.path.join(profile_dir, "antigravity-oauth-token")
        try:
            with open(CLI_TOKEN_PATH, "r") as f:
                cur_data = json.load(f)
            with open(profile_token, "w") as f:
                json.dump(cur_data, f, indent=2)
            safe_chmod_600(profile_token)
        except Exception:
            pass

# --- Commands ---

def list_accounts():
    init_vault()
    sync_active_token_to_vault()
    accounts = load_accounts().get("profiles", {})
    active = get_active_alias()

    print()
    print(bold("==============================================================="))
    print(bold(cyan("           ANTIGRAVITY CLI (AGY) ACCOUNT MANAGER              ")))
    print(bold("==============================================================="))
    print(dim("  Sessions & History: ") + green("Shared & Preserved across accounts"))
    print(bold("---------------------------------------------------------------"))

    if not accounts:
        print(yellow("  No accounts found in vault."))
        print(dim("  Run 'agy-switch add' to log in with an account."))
        print(bold("---------------------------------------------------------------"))
        return []

    account_keys = list(accounts.keys())
    for idx, alias in enumerate(account_keys, start=1):
        info = accounts[alias]
        email = info.get("email", "unknown")
        name = info.get("name", "")
        profile_token = os.path.join(PROFILES_DIR, alias, "antigravity-oauth-token")

        status_str = dim("Missing Token")
        if os.path.exists(profile_token):
            try:
                with open(profile_token, "r") as f:
                    tdata = json.load(f)
                status_str = format_expiry(tdata.get("token", {}).get("expiry"))
            except Exception:
                status_str = red("Corrupted")

        is_active = (alias == active)
        marker = green("● ACTIVE  ") if is_active else dim("○         ")
        prefix = f" [{idx}] {marker} {bold(alias.ljust(12))} "
        print(f"{prefix} {cyan(email.ljust(28))} {status_str}")
        if name:
            print(f"       {dim('└─ ' + name)}")

    print(bold("---------------------------------------------------------------"))
    print()
    return account_keys

def switch_account(identifier):
    init_vault()
    accounts = load_accounts().get("profiles", {})
    if not accounts:
        print(red("No accounts available to switch. Run 'agy-switch add' first."))
        return False

    keys = list(accounts.keys())
    target_alias = None

    if identifier.isdigit():
        idx = int(identifier) - 1
        if 0 <= idx < len(keys):
            target_alias = keys[idx]

    if not target_alias:
        for alias, meta in accounts.items():
            if alias.lower() == identifier.lower() or meta.get("email", "").lower() == identifier.lower():
                target_alias = alias
                break

    if not target_alias:
        print(red(f"Error: Account matching '{identifier}' not found in vault."))
        print(dim("Registered accounts:"))
        for a, m in accounts.items():
            print(f"  • {bold(a)} ({cyan(m.get('email'))})")
        print()
        if sys.stdin.isatty():
            try:
                ans = input(bold(f"Would you like to log in and add '{identifier}' now? [Y/n]: ")).strip().lower()
                if ans in ("", "y", "yes"):
                    return add_account(identifier)
            except KeyboardInterrupt:
                print()
                return False
        else:
            print(yellow(f"To add this account, run: agy-switch add {identifier}"))
        return False

    # 1. Sync current token back to vault first
    sync_active_token_to_vault()

    # 2. Check target token
    target_token_file = os.path.join(PROFILES_DIR, target_alias, "antigravity-oauth-token")
    if not os.path.exists(target_token_file):
        print(red(f"Error: Token file missing for profile '{target_alias}'."))
        return False

    with open(target_token_file, "r") as f:
        tdata = json.load(f)

    # 3. Ensure token is fresh
    tdata, refreshed = ensure_valid_token(tdata)
    if refreshed:
        with open(target_token_file, "w") as f:
            json.dump(tdata, f, indent=2)
        safe_chmod_600(target_token_file)

    # 4. Copy into agy CLI directory
    os.makedirs(CLI_DIR, exist_ok=True)
    with open(CLI_TOKEN_PATH, "w") as f:
        json.dump(tdata, f, indent=2)
    safe_chmod_600(CLI_TOKEN_PATH)

    # 5. Set active
    set_active_alias(target_alias)
    accounts[target_alias]["last_used"] = datetime.now(timezone.utc).isoformat()
    save_accounts({"profiles": accounts})

    meta = accounts[target_alias]
    print(green(f"✔ Successfully switched to account: {bold(target_alias)} ({cyan(meta.get('email'))})"))
    if refreshed:
        print(cyan("ℹ Token was refreshed automatically with a new 1-hour expiry."))
    print(dim("ℹ All your sessions, conversations, and projects remain active & preserved."))

    # Immediate quota & verification check
    check_and_handle_verification(target_alias, tdata, interactive=True)

    running = check_running_agy()
    if running:
        print(yellow(f"\n⚠️  Notice: An active 'agy' session is running in another terminal (PID: {', '.join(running)})."))
        print(dim("   'agy' holds credentials in memory, so that running session will not switch mid-flight."))
        print(bold(cyan("   To use the new account on that chat:")))
        print(bold(cyan("   1. Type /exit (or Ctrl+D) in the other terminal")))
        print(bold(cyan("   2. Resume your exact chat: agy -c\n")))

    return True

def add_account(alias=None):
    init_vault()
    sync_active_token_to_vault()

    accounts = load_accounts().get("profiles", {})

    print()
    print(bold(cyan("=== Add New Antigravity Pro Account ===")))
    print("This will launch the Google OAuth authentication flow.")
    print("Sign in with your other Google Pro account in your browser,")
    print("approve permissions, and paste the authorization code.\n")

    suggested_alias = alias
    if not suggested_alias:
        default_name = f"account-{len(accounts) + 1}"
        ans = input(f"Enter an alias/name for this account [{default_name}]: ").strip()
        suggested_alias = ans if ans else default_name

    clean_alias = re.sub(r"[^a-zA-Z0-9_\-\.]", "_", suggested_alias)

    staging_dir = os.path.join(VAULT_DIR, ".staging_login")
    if os.path.exists(staging_dir):
        shutil.rmtree(staging_dir, ignore_errors=True)

    staging_cli_dir = os.path.join(staging_dir, ".gemini", "antigravity-cli")
    os.makedirs(staging_cli_dir, exist_ok=True)

    if os.path.exists(CLI_SETTINGS_PATH):
        try:
            shutil.copy2(CLI_SETTINGS_PATH, os.path.join(staging_cli_dir, "settings.json"))
        except Exception:
            pass

    env = os.environ.copy()
    env["HOME"] = staging_dir
    # On Windows USERPROFILE serves as HOME
    env["USERPROFILE"] = staging_dir

    agy_bin = get_agy_bin()

    print(bold("Launching login process..."))
    print(yellow("Tip: If you're signed into Account 1 in your browser,"))
    print(yellow("open the link in Incognito/Private mode to sign into your other account."))
    print()

    try:
        p = subprocess.Popen(
            [agy_bin, "--print", "Authentication successful", "--print-timeout", "180s"],
            env=env
        )
        p.wait()
    except KeyboardInterrupt:
        print(yellow("\nLogin cancelled by user."))
        shutil.rmtree(staging_dir, ignore_errors=True)
        return False
    except Exception as e:
        print(red(f"\nError running agy: {e}"))
        shutil.rmtree(staging_dir, ignore_errors=True)
        return False

    staged_token_path = os.path.join(staging_cli_dir, "antigravity-oauth-token")
    if not os.path.exists(staged_token_path):
        print(red("\nLogin failed or token was not generated."))
        shutil.rmtree(staging_dir, ignore_errors=True)
        return False

    try:
        with open(staged_token_path, "r") as f:
            tdata = json.load(f)

        tok, _ = ensure_valid_token(tdata)
        access_tok = tok.get("token", {}).get("access_token")
        uinfo = fetch_user_info(access_tok)
        email = uinfo.get("email", "unknown@google.com")
        name = uinfo.get("name", "")

        profile_dir = os.path.join(PROFILES_DIR, clean_alias)
        os.makedirs(profile_dir, exist_ok=True)
        target_token = os.path.join(profile_dir, "antigravity-oauth-token")
        with open(target_token, "w") as f:
            json.dump(tok, f, indent=2)
        safe_chmod_600(target_token)

        accounts[clean_alias] = {
            "alias": clean_alias,
            "email": email,
            "name": name,
            "added_at": datetime.now(timezone.utc).isoformat(),
            "last_used": datetime.now(timezone.utc).isoformat()
        }
        save_accounts({"profiles": accounts})
        shutil.rmtree(staging_dir, ignore_errors=True)

        print()
        print(green("✔ Account successfully added!"))
        print(f"  Alias: {bold(clean_alias)}")
        print(f"  Email: {cyan(email)}")
        if name:
            print(f"  Name:  {name}")

        ans = input(f"\nDo you want to switch to '{clean_alias}' now? [Y/n]: ").strip().lower()
        if ans in ("", "y", "yes"):
            switch_account(clean_alias)
        return True
    except Exception as e:
        print(red(f"Error saving account: {e}"))
        shutil.rmtree(staging_dir, ignore_errors=True)
        return False

def import_token(file_path, alias=None):
    """Imports an existing antigravity-oauth-token JSON file."""
    init_vault()
    if not os.path.exists(file_path):
        print(red(f"File not found: {file_path}"))
        return False

    try:
        with open(file_path, "r") as f:
            tdata = json.load(f)

        if "token" not in tdata or "access_token" not in tdata["token"]:
            print(red("Invalid token JSON format."))
            return False

        tdata, _ = ensure_valid_token(tdata)
        access_tok = tdata.get("token", {}).get("access_token")
        uinfo = fetch_user_info(access_tok)
        email = uinfo.get("email", "imported@google.com")
        name = uinfo.get("name", "")

        accounts = load_accounts().get("profiles", {})
        if not alias:
            email_user = email.split("@")[0]
            alias = re.sub(r"[^a-zA-Z0-9_\-]", "_", email_user)
            if alias in accounts:
                alias = f"{alias}-{len(accounts) + 1}"

        profile_dir = os.path.join(PROFILES_DIR, alias)
        os.makedirs(profile_dir, exist_ok=True)
        target_token = os.path.join(profile_dir, "antigravity-oauth-token")
        with open(target_token, "w") as f:
            json.dump(tdata, f, indent=2)
        safe_chmod_600(target_token)

        accounts[alias] = {
            "alias": alias,
            "email": email,
            "name": name,
            "added_at": datetime.now(timezone.utc).isoformat(),
            "last_used": datetime.now(timezone.utc).isoformat()
        }
        save_accounts({"profiles": accounts})
        print(green(f"✔ Successfully imported token as '{bold(alias)}' ({cyan(email)})"))
        return True
    except Exception as e:
        print(red(f"Import error: {e}"))
        return False

def export_token(alias, out_path):
    init_vault()
    sync_active_token_to_vault()
    accounts = load_accounts().get("profiles", {})
    if alias not in accounts:
        print(red(f"Account '{alias}' not found."))
        return False

    src_token = os.path.join(PROFILES_DIR, alias, "antigravity-oauth-token")
    if not os.path.exists(src_token):
        print(red(f"Token file for '{alias}' does not exist."))
        return False

    shutil.copy2(src_token, out_path)
    safe_chmod_600(out_path)
    print(green(f"✔ Token for '{alias}' exported to: {out_path}"))
    return True

def remove_account(alias):
    init_vault()
    accounts = load_accounts().get("profiles", {})
    if alias not in accounts:
        print(red(f"Account '{alias}' not found."))
        return False

    active = get_active_alias()
    if alias == active:
        print(yellow(f"Warning: '{alias}' is the currently active account!"))
        ans = input("Are you sure you want to delete the active account? [y/N]: ").strip().lower()
        if ans not in ("y", "yes"):
            print("Aborted.")
            return False

    profile_dir = os.path.join(PROFILES_DIR, alias)
    if os.path.exists(profile_dir):
        shutil.rmtree(profile_dir, ignore_errors=True)

    del accounts[alias]
    save_accounts({"profiles": accounts})

    if alias == active:
        set_active_alias("")
        if os.path.exists(CLI_TOKEN_PATH):
            os.remove(CLI_TOKEN_PATH)
        print(yellow("Active account removed. Antigravity CLI is now unauthenticated."))
        remaining = list(accounts.keys())
        if remaining:
            print(f"Switching to '{remaining[0]}'...")
            switch_account(remaining[0])
    else:
        print(green(f"✔ Removed account '{alias}'."))
    return True

def rename_account(old_alias, new_alias):
    init_vault()
    accounts = load_accounts().get("profiles", {})
    if old_alias not in accounts:
        print(red(f"Account '{old_alias}' not found."))
        return False
    if new_alias in accounts:
        print(red(f"Account '{new_alias}' already exists."))
        return False

    clean_new = re.sub(r"[^a-zA-Z0-9_\-\.]", "_", new_alias)
    old_dir = os.path.join(PROFILES_DIR, old_alias)
    new_dir = os.path.join(PROFILES_DIR, clean_new)
    if os.path.exists(old_dir):
        os.rename(old_dir, new_dir)

    meta = accounts.pop(old_alias)
    meta["alias"] = clean_new
    accounts[clean_new] = meta
    save_accounts({"profiles": accounts})

    if get_active_alias() == old_alias:
        set_active_alias(clean_new)

    print(green(f"✔ Renamed '{old_alias}' to '{clean_new}'."))
    return True

