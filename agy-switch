# Antigravity OAuth Client Credentials (unmasked at runtime)
_K = 0x5A
_MCID = [107, 106, 109, 107, 106, 106, 108, 106, 108, 106, 111, 99, 107, 119, 46, 55, 50, 41, 41, 51, 52, 104, 50, 104, 107, 54, 57, 40, 63, 104, 105, 111, 44, 46, 53, 54, 53, 48, 50, 110, 61, 110, 106, 105, 63, 42, 116, 59, 42, 42, 41, 116, 61, 53, 53, 61, 54, 63, 47, 41, 63, 40, 57, 53, 52, 46, 63, 52, 46, 116, 57, 53, 55]
_MSEC = [29, 21, 25, 9, 10, 2, 119, 17, 111, 98, 28, 13, 8, 110, 98, 108, 22, 62, 22, 16, 107, 55, 22, 24, 98, 41, 2, 25, 110, 32, 108, 43, 30, 27, 60]
CLIENT_ID = bytes([b ^ _K for b in _MCID]).decode("utf-8")
CLIENT_SECRET = bytes([b ^ _K for b in _MSEC]).decode("utf-8")

# --- Helper: Locate Underlying agy Binary ---
def get_agy_bin():
    """Locates the genuine agy binary, bypassing wrappers if present."""
    prefix = os.environ.get("PREFIX", "")
    if prefix:
        termux_real = os.path.join(prefix, "bin", "agy-real")
        if os.path.exists(termux_real):
            return termux_real

    agy_real = shutil.which("agy-real")
    if agy_real:
        return agy_real

    agy_std = shutil.which("agy")
    if agy_std:
        return agy_std

    for candidate in [
        os.path.expanduser("~/.local/bin/agy-real"),
        os.path.expanduser("~/.local/bin/agy"),
        "/usr/local/bin/agy-real",
        "/usr/local/bin/agy",
        "/data/data/com.termux/files/usr/bin/agy-real",
        "/data/data/com.termux/files/usr/bin/agy",
    ]:
        if os.path.exists(candidate):
            return candidate

    return "agy"

def check_running_agy():
    """Detects if another agy process is currently running."""
    try:
        out = subprocess.check_output(["ps", "-eo", "pid,comm,args"], text=True)
        running = []
        my_pid = os.getpid()
        for line in out.strip().splitlines()[1:]:
            parts = line.split(None, 2)
            if len(parts) >= 3:
                pid, comm, args = parts[0], parts[1], parts[2]
                if "agy.va39" in args or ("agy" in comm and "agy-switch" not in args and "grep" not in args):
                    try:
                        if int(pid) != my_pid:
                            running.append(pid)
                    except Exception:
                        pass
        return running
    except Exception:
        return []

# --- Styling & Colors ---
IS_TTY = sys.stdout.isatty()

def style(text, *codes):
    if not IS_TTY:
        return text
    prefix = "".join(f"\033[{c}m" for c in codes)
    return f"{prefix}{text}\033[0m"

def bold(text): return style(text, 1)
def green(text): return style(text, 32)
def cyan(text): return style(text, 36)
def yellow(text): return style(text, 33)
def red(text): return style(text, 31)
def dim(text): return style(text, 2)
def magenta(text): return style(text, 35)

def safe_chmod_600(filepath):
    """Sets file permissions to 0600 safely across POSIX and Windows."""
    try:
        os.chmod(filepath, 0o600)
    except Exception:
        pass

